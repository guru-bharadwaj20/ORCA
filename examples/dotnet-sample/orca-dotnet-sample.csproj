<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal console app on the base SDK — no external packages, so `dotnet restore`
       and `dotnet publish` are hermetic. The published dll (orca-dotnet-sample.dll) is
       what ORCA fills into the recipe's {{dll}}. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>orca-dotnet-sample</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
