# syntax=docker/dockerfile:1
# ORCA Stage 1 — Node service (React client or Express server), dev mode.
FROM {{baseImage}}
ENV NODE_ENV=development
WORKDIR {{workdir}}

{{#if systemPackages}}
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{{join systemPackages " "}}} \
    && rm -rf /var/lib/apt/lists/*

{{/if}}
COPY {{{join dependencyFiles " "}}} ./
RUN {{{installCommand}}}

COPY . .
{{#if buildCommand}}
RUN {{{buildCommand}}}
{{/if}}

{{{exposeLines ports port}}}

CMD {{{startCommand}}}
