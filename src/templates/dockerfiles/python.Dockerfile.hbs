# syntax=docker/dockerfile:1
# ORCA Stage 1 — Python service (Django app), dev mode.
FROM {{baseImage}}
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR {{workdir}}

{{#if systemPackages}}
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{{join systemPackages " "}}} \
    && rm -rf /var/lib/apt/lists/*

{{/if}}
COPY {{{join dependencyFiles " "}}} ./
RUN {{{installCommand}}}

COPY . .

{{{exposeLines ports port}}}

{{#if entrypointScript}}
COPY {{entrypointScript}} /usr/local/bin/orca-entrypoint
RUN chmod +x /usr/local/bin/orca-entrypoint
ENTRYPOINT ["/usr/local/bin/orca-entrypoint"]

{{/if}}
CMD {{{startCommand}}}
