name: {{projectName}}

services:
{{#each services}}
  {{name}}:
{{#if build}}
    build:
      context: {{build.context}}
      dockerfile: {{build.dockerfile}}
{{/if}}
{{#if image}}
    image: {{image}}
{{/if}}
{{#if (hasItems ports)}}
    ports:
{{#each ports}}
      - "{{this}}"
{{/each}}
{{/if}}
{{#if (hasItems environment)}}
    environment:
{{#each environment}}
      {{@key}}: "{{{this}}}"
{{/each}}
{{/if}}
{{#if envFile}}
    env_file:
      - {{envFile}}
{{/if}}
{{#if (hasItems dependsOn)}}
    depends_on:
{{#each dependsOn}}
{{#if this.service}}
      {{this.service}}:
        condition: {{this.condition}}
{{else}}
      - {{this}}
{{/if}}
{{/each}}
{{/if}}
{{#if (hasItems volumes)}}
    volumes:
{{#each volumes}}
      - "{{this}}"
{{/each}}
{{/if}}
    networks:
      - {{../networkName}}
{{#if healthcheck}}
    healthcheck:
      test: [{{{quoteJoin healthcheck.test}}}]
      interval: {{healthcheck.interval}}
      timeout: {{healthcheck.timeout}}
      retries: {{healthcheck.retries}}
{{/if}}

{{/each}}
networks:
  {{networkName}}:
    driver: bridge

volumes:
{{#each namedVolumes}}
  {{this}}:
{{/each}}
