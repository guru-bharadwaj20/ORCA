# ORCA is BYOK (bring your own keys). Copy this file to `.env` and fill in your keys.

# Primary provider (Qwen3-Coder): your Qwen/DashScope API key. If unset, ORCA
# escalates straight to the Anthropic fallback.
QWEN_API_KEY=

# Fallback provider (Claude): your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible endpoint the Qwen provider posts to. Defaults to
# DashScope; point it at vLLM / Ollama / OpenRouter to self-host.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: override the per-provider models.
# ORCA_QWEN_MODEL=qwen3-coder-plus
# ORCA_MODEL=claude-opus-4-8

# Optional: provider routing. Primary is tried first (with retries); the fallback
# takes over when the primary fails. Set fallback to "none" to disable escalation.
# ORCA_PRIMARY_PROVIDER=qwen
# ORCA_FALLBACK_PROVIDER=anthropic
# ORCA_MAX_PRIMARY_ATTEMPTS=2

# Optional: hard cap on total LLM spend per run (all providers combined), in USD.
# ORCA_COST_CAP_USD=1.00

# Optional: max self-heal retry attempts (default 3).
# ORCA_MAX_HEAL_ATTEMPTS=3
