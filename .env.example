# ORCA is BYOK (bring your own key). Copy this file to `.env` and fill in your key.

# Required: your Anthropic API key. ORCA never ships or stores a key for you.
ANTHROPIC_API_KEY=

# Optional: override the default model used for template-filling / self-heal.
# ORCA_MODEL=claude-opus-4-8

# Optional: hard cap on total LLM spend per run, in USD. ORCA aborts if exceeded.
# ORCA_COST_CAP_USD=1.00

# Optional: max self-heal retry attempts (default 3).
# ORCA_MAX_HEAL_ATTEMPTS=3
