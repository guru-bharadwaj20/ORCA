{
  "name": "orca-vscode",
  "displayName": "ORCA",
  "version": "0.0.0",
  "private": true,
  "description": "Clone, containerize, and self-heal a repo from the editor — a VS Code front end for the ORCA CLI.",
  "license": "MIT",
  "publisher": "orca",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "orca.previewRepo",
        "title": "Preview Repo (Dry Run)",
        "category": "ORCA"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-cli --external:orca-cli/plan --outfile=dist/extension.js --sourcemap && node scripts/copy-media.mjs",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-cli --external:orca-cli/plan --outfile=dist/extension.js --sourcemap --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-cli --external:orca-cli/plan --outfile=dist/extension.js --minify && node scripts/copy-media.mjs"
  },
  "dependencies": {
    "orca-cli": "file:.."
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "mermaid": "^11.16.0"
  }
}
