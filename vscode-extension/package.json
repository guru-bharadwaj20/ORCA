{
  "name": "orca-vscode",
  "displayName": "ORCA",
  "version": "0.1.0",
  "private": true,
  "description": "Clone, containerize, and self-heal a repo from the editor — a VS Code front end for the ORCA CLI.",
  "license": "MIT",
  "publisher": "orca",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VivianSobers/ORCA.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/VivianSobers/ORCA/issues"
  },
  "homepage": "https://github.com/VivianSobers/ORCA#readme",
  "keywords": [
    "docker",
    "docker-compose",
    "containerization",
    "ai",
    "devtools",
    "hackathon"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "orca.previewRepo",
        "title": "Preview Repo (Dry Run)",
        "category": "ORCA"
      },
      {
        "command": "orca.runRepo",
        "title": "Run Repo",
        "category": "ORCA"
      },
      {
        "command": "orca.setApiKey",
        "title": "Set API Key",
        "category": "ORCA"
      }
    ],
    "configuration": {
      "title": "ORCA",
      "properties": {
        "orca.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model id for AI stages. `claude-*` routes to Anthropic, `qwen*` to Qwen; other ids are ignored. Empty uses ORCA's default. Overrides the `ORCA_MODEL` env var."
        },
        "orca.costCapUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "markdownDescription": "Hard cap on total LLM spend per run, in USD. Overrides the `ORCA_COST_CAP_USD` env var."
        },
        "orca.maxHealAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "markdownDescription": "Maximum self-heal attempts before giving up. Overrides the `ORCA_MAX_HEAL_ATTEMPTS` env var."
        },
        "orca.primaryProvider": {
          "type": "string",
          "enum": [
            "qwen",
            "anthropic"
          ],
          "default": "qwen",
          "markdownDescription": "AI provider tried first. Overrides the `ORCA_PRIMARY_PROVIDER` env var."
        },
        "orca.fallbackProvider": {
          "type": "string",
          "enum": [
            "anthropic",
            "qwen",
            "none"
          ],
          "default": "anthropic",
          "markdownDescription": "Provider used when the primary keeps failing (`none` disables fallback). Overrides the `ORCA_FALLBACK_PROVIDER` env var."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-agent-cli --external:orca-agent-cli/plan --external:orca-agent-cli/config --external:orca-agent-cli/ai --outfile=dist/extension.js --sourcemap && node scripts/copy-media.mjs",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-agent-cli --external:orca-agent-cli/plan --external:orca-agent-cli/config --external:orca-agent-cli/ai --outfile=dist/extension.js --sourcemap --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/preview-smoke.cjs",
    "package": "node scripts/package-vsix.mjs",
    "vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:orca-agent-cli --external:orca-agent-cli/plan --external:orca-agent-cli/config --external:orca-agent-cli/ai --outfile=dist/extension.js --minify && node scripts/copy-media.mjs"
  },
  "dependencies": {
    "orca-agent-cli": "file:.."
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "mermaid": "^11.16.0"
  }
}
