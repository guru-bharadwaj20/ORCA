# The extension ships as a bundled dist/extension.js plus media/ (icon + mermaid)
# plus node_modules (production deps only — vsce prunes dev deps; orca-agent-cli
# is loaded from there at runtime). Source, tooling, and tests are excluded.
.vscode/**
src/**
scripts/**
test/**
tsconfig.json
.vscodeignore
**/*.ts
**/*.map
