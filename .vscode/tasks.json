{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "orca: build extension",
      "detail": "Build orca-repo-agent (dist) then bundle the extension so F5 has fresh output.",
      "dependsOrder": "sequence",
      "dependsOn": ["orca: build core", "orca: bundle extension"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "orca: build core",
      "detail": "Compile orca-repo-agent to dist/ (the extension imports it at runtime).",
      "type": "npm",
      "script": "build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "orca: bundle extension",
      "detail": "esbuild-bundle the extension into vscode-extension/dist.",
      "type": "npm",
      "script": "build",
      "path": "vscode-extension",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
